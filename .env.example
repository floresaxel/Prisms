# Prisms production secrets + config (docker-compose.prod.yml).
# Copy to `.env` and fill in. Generate secrets with: openssl rand -base64 48
# `.env` is gitignored — never commit real secrets (§13).

# --- public URL (where users reach the web app; feeds Better Auth + CORS) ---
# PUBLIC_URL=https://prisms.example.com
# WEB_PORT=8088

# --- Postgres (source of truth) ---
# NB: POSTGRES_PASSWORD goes into the postgresql:// connection URIs, so it must
# be URL-safe — generate it with `openssl rand -hex 32`. A base64 value can
# contain `/`, which breaks URI parsing. (base64 above is fine for the rest.)
# POSTGRES_USER=prisms
# POSTGRES_PASSWORD=change-me-url-safe-db-password
# POSTGRES_DB=prisms

# --- Better Auth (session/JWT signing) ---
# BETTER_AUTH_SECRET=change-me-32+-byte-random-secret

# --- PowerSync JWT (the API signs HS256 tokens the sync service validates) ---
# 1. POWERSYNC_JWT_SECRET: a >=32-byte secret the API signs with.
# 2. POWERSYNC_JWT_K_B64URL: the SAME secret, base64url-encoded, for the
#    PowerSync jwks `k` field. Keep them in sync:
#      printf %s "$POWERSYNC_JWT_SECRET" | basenc --base64url | tr -d '='
# POWERSYNC_JWT_SECRET=change-me-32+-byte-powersync-secret
# POWERSYNC_JWT_K_B64URL=change-me-base64url-of-the-secret-above
# POWERSYNC_JWT_KID=prisms
# POWERSYNC_JWT_AUDIENCE=prisms

# --- local dev compose port overrides (docker-compose.yml only) ---
# PRISMS_POSTGRES_PORT=5434
# PRISMS_POWERSYNC_PORT=8081
