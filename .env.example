# Prisms production secrets + config (docker-compose.prod.yml).
# Copy to `.env` and fill in. Generate secrets with `openssl rand -base64 48`
# — except POSTGRES_PASSWORD, which must be URL-safe (see the Postgres note).
# `.env` is gitignored — never commit real secrets (§13).

# --- public URL (where users reach the web app; feeds Better Auth + CORS) ---
# PUBLIC_URL=https://prisms.example.com
# WEB_PORT=8088

# --- Postgres (source of truth) ---
# NB: POSTGRES_PASSWORD goes into the postgresql:// connection URIs (the api's
# DATABASE_URL and powersync's PS_DATABASE_URI/PS_STORAGE_URI), so it must be
# URL-safe — generate it with `openssl rand -hex 32`. A base64 value can contain
# `/`, which breaks URI parsing and crash-loops api + powersync on a fresh
# deploy. (base64 is fine for the other, non-URL secrets below.)
# The api now REFUSES TO START on a URL it cannot parse, naming the password as
# the suspect (packages/db/src/url.ts) — but powersync is a third-party service
# with no such guard, so it would still crash-loop. The rule stands.
# POSTGRES_USER=prisms
# POSTGRES_PASSWORD=change-me-url-safe-db-password
# POSTGRES_DB=prisms

# --- Better Auth (session/JWT signing) ---
# BETTER_AUTH_SECRET=change-me-32+-byte-random-secret

# --- account policy (SEC-2) ---
# Lock down registration once your accounts exist. On an internet-reachable
# origin, open sign-up lets anyone create accounts on your node.
# PRISMS_DISABLE_SIGNUP=1
# Minimum password length (default 12).
# PRISMS_MIN_PASSWORD_LENGTH=12
# Per-IP requests/minute against the credential endpoints (sign-in, sign-up,
# password change/reset). Default 10. Counts the client IP that the reverse
# proxy reports in X-Real-IP; if that header is absent ALL callers share one
# bucket, which throttles harder rather than not at all.
# AUTH_RATE_LIMIT=10

# --- PowerSync JWT (the API signs HS256 tokens the sync service validates) ---
# The sync config (infra/powersync/powersync.prod.yaml) reads these via `!env`,
# and PowerSync only substitutes names prefixed PS_ — so they are PS_JWT_*.
# 1. PS_JWT_SECRET: a >=32-byte secret the API signs with.
# 2. PS_JWT_K_B64URL: the SAME secret, base64url-encoded, for the PowerSync
#    jwks `k` field. Keep them in sync:
#      printf %s "$PS_JWT_SECRET" | basenc --base64url | tr -d '='
# PS_JWT_SECRET=change-me-32+-byte-powersync-secret
# PS_JWT_K_B64URL=change-me-base64url-of-the-secret-above
# PS_JWT_KID=prisms
# PS_JWT_AUDIENCE=prisms

# --- local dev compose port overrides (docker-compose.yml only) ---
# PRISMS_POSTGRES_PORT=5434
# PRISMS_POWERSYNC_PORT=8081
