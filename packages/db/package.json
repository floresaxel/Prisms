{
  "name": "@prisms/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema, forward-only migrations, PowerSync sync rules (ARCHITECTURE.md §6). Imports core types only.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/cli/db-migrate.ts",
    "db:seed": "tsx src/cli/db-seed.ts",
    "sync-rules:check": "tsx src/cli/check-sync-rules.ts"
  },
  "dependencies": {
    "@prisms/core": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@powersync/service-sync-rules": "^0.37.0",
    "@types/node": "^24.13.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
