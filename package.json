{
  "name": "prisms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:convergence": "pnpm --filter @prisms/server test:convergence",
    "test:integration": "pnpm --filter @prisms/db --filter @prisms/server test",
    "test:e2e": "pnpm --filter @prisms/web e2e",
    "test:perf": "pnpm --filter @prisms/core test -- load.perf",
    "build": "turbo run build",
    "ci": "turbo run lint typecheck test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^6.0.2",
    "globals": "^17.6.0",
    "turbo": "^2.9.17",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  }
}
